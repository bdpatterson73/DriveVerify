<UserControl x:Class="DriveVerify.Views.HeatmapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800"
             ClipToBounds="True">
    <Border Background="#0A0C10" BorderBrush="#1E3A45" BorderThickness="1" CornerRadius="4" Padding="4">
        <Border.Effect>
            <DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.25" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Image x:Name="HeatmapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <!-- Subtle gloss highlight over the cells -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.4" />
                        <GradientStop Color="#20000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Animated scanline sweep while a test is running -->
            <Canvas x:Name="ScanCanvas" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="ScanLine" Width="90" Canvas.Left="-100" Visibility="Collapsed"
                           Height="{Binding ActualHeight, ElementName=ScanCanvas}">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000E5FF" Offset="0" />
                            <GradientStop Color="#4800E5FF" Offset="0.85" />
                            <GradientStop Color="#B0A0F4FF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
